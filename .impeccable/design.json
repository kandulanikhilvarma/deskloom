      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font:650 12px/1.6 Manrope,sans-serif;color:var(--ink)}.ds-field input{min-height:44px;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);font:inherit}.ds-field input:hover{border-color:var(--accent)}.ds-field input:focus-visible{outline:3px solid var(--clay);outline-offset:4px}",
      "refersTo": "field"
    },
    {
      "name": "Catalog group navigation",
      "kind": "nav",
      "description": "Move between workspace product families.",
      "html": "<nav class=\"ds-groups\" aria-label=\"Product families\"><button aria-pressed=\"true\">Electronics</button><button aria-pressed=\"false\">Desks and chairs</button></nav>",
      "css": ".ds-groups{display:flex;flex-wrap:wrap;gap:0 18px;border-bottom:1px solid var(--line)}.ds-groups button{min-height:44px;padding:8px 0;border:0;border-bottom:2px solid transparent;background:transparent;color:var(--muted);font:400 12px/1.6 Manrope,sans-serif;cursor:pointer}.ds-groups button[aria-pressed=true]{color:var(--ink);border-bottom-color:var(--accent);font-weight:750}.ds-groups button:hover{color:var(--accent)}.ds-groups button:focus-visible{outline:3px solid var(--clay);outline-offset:4px}"
