      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:11px 15px;border-radius:7px;font:650 11px/1.6 Manrope,sans-serif;cursor:pointer;border:1px solid var(--line);background:var(--surface);color:var(--ink)}.ds-secondary:hover{background:var(--tint)}.ds-secondary:focus-visible{outline:3px solid var(--clay);outline-offset:4px}",
