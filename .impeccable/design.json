  "narrative": {
    "northStar": "The residential material library",
    "overview": "Deskloom follows a material library in a residential design studio. Warm paper surfaces surround real product photographs and practical choices. The interface stays compact so users can compare objects in their own rooms.\n\nCredited room photographs give context for materials, light, and useful furniture. Product photographs show exact models separately. The existing identity uses dark green controls, clay accents, Manrope interface text, and Fraunces titles.",
    "keyCharacteristics": [
      "Six photo-led entry choices expose the range of workspace products.",
      "Real room stories keep photographer credits and source links.",
      "Separate rails keep preferences and the current product total close to the editor.",
      "Visible borders and quiet surfaces organize dense product information."
    ],
    "rules": [
      {
        "name": "The Surface Rule",
        "body": "Use the existing semantic variables for interface surfaces and text. Keep product and room photographs separate from interface color treatments.",
        "section": "colors"
      },
      {
        "name": "The Model Name Rule",
        "body": "Use Manrope for product names and specifications. Reserve Fraunces for editorial titles and introductions.",
        "section": "typography"
      },
      {
        "name": "The Discovery Order Rule",
        "body": "Keep the six product choices before phone preferences. Keep product discovery near the top of the desktop center rail.",
        "section": "layout"
      },
      {
        "name": "The Quiet Depth Rule",
        "body": "Use borders and tonal separation for ordinary content. Reserve the shared ambient shadow for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve paper surfaces, dark green controls, clay emphasis, and the existing type pairing.",
      "Do use real product photographs with visible model names and local product links.",
      "Do keep photographer credits directly beside room photographs.",
      "Do keep the six product choices ahead of preferences on phones.",
      "Do show budget context beside product decisions and plan actions.",
      "Do keep visible keyboard focus and reduced-motion behavior."
    ],
    "donts": [
      "Do not describe the six room photographs as AI room concepts or exact product matches.",
      "Do not replace product photographs with decorative silhouettes when a photograph fails.",
      "Do not tint photographs to imitate the interface palette.",
      "Do not hide model specifications or materials behind a family photograph alone."
    ]
  }
