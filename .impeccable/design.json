      "css": ".ds-card{min-width:0;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:10px;padding:16px;font:400 12px/1.7 Manrope,sans-serif}.ds-card h4{font-size:15px;line-height:1.6;margin:6px 0 12px;font-weight:650}.ds-card p{color:var(--muted)}.ds-card button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:11px 15px;border-radius:7px;font:650 11px/1.6 Manrope,sans-serif;cursor:pointer;width:100%;border:1px solid var(--line);background:var(--surface);color:var(--ink)}.ds-card button:hover{background:var(--tint)}.ds-card button:focus-visible{outline:3px solid var(--clay);outline-offset:4px}",
