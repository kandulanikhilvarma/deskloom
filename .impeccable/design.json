      "css": ".ds-family{display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:14px;border:1px solid var(--line);border-radius:10px;text-align:left;min-width:0;background:var(--surface);color:var(--ink);font:400 13px/1.6 Manrope,sans-serif;cursor:pointer}.ds-family:hover{border-color:var(--accent)}.ds-family:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-photo{display:grid;place-items:center;min-height:78px;width:100%;background:var(--soft);color:var(--muted);font-size:11px}.ds-family strong{display:block;font-size:14px}.ds-family small{display:block;font-size:11px;line-height:1.7;margin-top:6px;color:var(--muted)}.ds-family svg{align-self:flex-end}"
