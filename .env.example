# Server secrets only. Never commit .env.local.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# Use a random value with at least 32 characters.
NEON_AUTH_COOKIE_SECRET=

# Keep disabled until the owner approves provider costs.
IMAGE_GENERATION_ENABLED=false
OPENAI_API_KEY=
# Optional for local Gateway use. Vercel deployments can use project OIDC.
AI_GATEWAY_API_KEY=
# Leave empty for the provider-specific default model.
IMAGE_MODEL=
